# Copy to .env and fill in the values: cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql://iris:iris@localhost:5432/iris

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# URL of the Next.js web app (CORS / trusted origin)
WEB_URL=http://localhost:3001

# ── Auth (better-auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# ── Redis (Bull job queue) ────────────────────────────────────────────────────
# Matches the redis service in docker-compose.yml
REDIS_URL=redis://localhost:6379

# ── Browser automation ────────────────────────────────────────────────────────
# LOCAL runs browsers via Playwright on this machine; BROWSERBASE uses the cloud
BROWSER_ENV=LOCAL
# Required only when BROWSER_ENV=BROWSERBASE — get keys at https://browserbase.com
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── LLM (Google Gemini) ───────────────────────────────────────────────────────
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Agent model (optional, defaults to google/gemini-2.5-flash) ──────────────
# AGENT_MODEL=google/gemini-2.5-flash

# ── Artifact storage (MinIO / S3-compatible) ──────────────────────────────────
# Defaults match the minio service in docker-compose.yml; uncomment to override
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=iris-artifacts
# MINIO_USE_SSL=false
# MINIO_PUBLIC_URL=http://localhost:9000

# ── Helicone LLM observability (optional) ─────────────────────────────────────
# Leave HELICONE_API_KEY empty to call Gemini directly (no observability).
# Hosted (free tier): https://helicone.ai
HELICONE_API_KEY=
HELICONE_BASE_URL=https://generativelanguage.hconeai.com
